rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lineupUsers/{uid}/workspace/current {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validWorkspace() {
        return request.resource.data.keys().hasOnly(['schema', 'revision', 'payload', 'deviceId', 'updatedAt'])
          && request.resource.data.schema == 1
          && request.resource.data.revision is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 850000
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() <= 100
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && validWorkspace() && request.resource.data.revision == 1;
      allow update: if owner() && validWorkspace()
        && request.resource.data.revision == resource.data.revision + 1;
      // Deletion and listing are not part of the sync protocol.
      allow delete, list: if false;
    }
  }
}
